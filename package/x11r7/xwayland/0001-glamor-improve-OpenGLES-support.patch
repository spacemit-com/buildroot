 glamor/glamor.c         | 14 ++++++++------
 glamor/glamor_egl.c     | 24 +++++++++++++++++++++++-
 glamor/glamor_points.c  |  3 ++-
 glamor/glamor_prepare.c | 25 +++++++++++++++++++------
 glamor/glamor_program.c |  5 -----
 glamor/glamor_xv.c      | 16 +++++++---------
 6 files changed, 59 insertions(+), 28 deletions(-)

diff --git a/glamor/glamor.c b/glamor/glamor.c
index 848b484cf..df8005c00 100644
--- a/glamor/glamor.c
+++ b/glamor/glamor.c
