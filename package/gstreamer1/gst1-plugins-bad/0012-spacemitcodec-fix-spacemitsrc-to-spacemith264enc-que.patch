   GstVideoFrame video_frame;
   gint32 ret;
   gint32 mppframe_id;
+  GstMemory *mem = NULL;
+  gint fd = -1;
 
   if (frame) {
     GST_DEBUG_OBJECT (thiz, "handle a frame %p, snb:%u, input buffer pts: %"  GST_TIME_FORMAT ", dts %" GST_TIME_FORMAT,
